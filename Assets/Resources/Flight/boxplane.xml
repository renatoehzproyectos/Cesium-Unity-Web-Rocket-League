<?xml version="1.0"?>
<!-- BoxPlane: a simple single-engine monoplane built from boxes. JSBSim FDM format (loadable by native JSBSim: aircraft/boxplane).
     Mass, inertia, geometry and the aerodynamic derivatives are simplified from JSBSim's c172x (GPL, Tony Peden); electric engine + the
     c172x fixed-pitch propeller. Structural frame: x aft, y right, z up, inches. -->
<fdm_config name="BoxPlane" version="2.0" release="BETA">
  <fileheader><author>RocketWorld</author><description>Simple box plane for RocketWorld, derived from JSBSim c172x data.</description></fileheader>
  <metrics>
    <wingarea unit="FT2"> 174.0 </wingarea>
    <wingspan unit="FT"> 36.0 </wingspan>
    <chord unit="FT"> 4.9 </chord>
    <htailarea unit="FT2"> 21.9 </htailarea>
    <htailarm unit="FT"> 15.7 </htailarm>
    <vtailarea unit="FT2"> 16.5 </vtailarea>
    <vtailarm unit="FT"> 15.7 </vtailarm>
    <location name="AERORP" unit="IN"><x> 43.2 </x><y> 0.0 </y><z> 59.4 </z></location>
    <location name="EYEPOINT" unit="IN"><x> 37.0 </x><y> 0.0 </y><z> 48.0 </z></location>
    <location name="VRP" unit="IN"><x> 42.6 </x><y> 0.0 </y><z> 38.5 </z></location>
  </metrics>
  <mass_balance>
    <ixx unit="SLUG*FT2"> 948.0 </ixx>
    <iyy unit="SLUG*FT2"> 1346.0 </iyy>
    <izz unit="SLUG*FT2"> 1967.0 </izz>
    <ixz unit="SLUG*FT2"> 0.0 </ixz>
    <emptywt unit="LBS"> 1700.0 </emptywt>
    <location name="CG" unit="IN"><x> 41.0 </x><y> 0.0 </y><z> 36.5 </z></location>
  </mass_balance>
  <ground_reactions>
    <contact type="BOGEY" name="Nose Gear">
      <location unit="IN"><x> -6.8 </x><y> 0.0 </y><z> -20.0 </z></location>
      <static_friction>0.8</static_friction><dynamic_friction>0.5</dynamic_friction><rolling_friction>0.022</rolling_friction>
      <spring_coeff unit="LBS/FT">1800</spring_coeff>
      <damping_coeff unit="LBS/FT/SEC">500</damping_coeff>
      <damping_coeff_rebound unit="LBS/FT/SEC">2000</damping_coeff_rebound>
      <max_steer unit="DEG">10</max_steer><brake_group>NONE</brake_group><retractable>0</retractable>
    </contact>
    <contact type="BOGEY" name="Left Main Gear">
      <location unit="IN"><x> 58.2 </x><y> -50.25 </y><z> -18.46 </z></location>
      <static_friction>0.8</static_friction><dynamic_friction>0.5</dynamic_friction><rolling_friction>0.022</rolling_friction>
      <spring_coeff unit="LBS/FT">5400</spring_coeff>
      <damping_coeff unit="LBS/FT/SEC">160</damping_coeff>
      <damping_coeff_rebound unit="LBS/FT/SEC">320</damping_coeff_rebound>
      <max_steer unit="DEG">0.0</max_steer><brake_group>LEFT</brake_group><retractable>0</retractable>
    </contact>
    <contact type="BOGEY" name="Right Main Gear">
      <location unit="IN"><x> 58.2 </x><y> 50.25 </y><z> -18.46 </z></location>
      <static_friction>0.8</static_friction><dynamic_friction>0.5</dynamic_friction><rolling_friction>0.022</rolling_friction>
      <spring_coeff unit="LBS/FT">5400</spring_coeff>
      <damping_coeff unit="LBS/FT/SEC">160</damping_coeff>
      <damping_coeff_rebound unit="LBS/FT/SEC">320</damping_coeff_rebound>
      <max_steer unit="DEG">0.0</max_steer><brake_group>RIGHT</brake_group><retractable>0</retractable>
    </contact>
  </ground_reactions>
  <propulsion>
    <engine file="eng_electric160">
      <thruster file="prop_75in2f">
        <location unit="IN"><x>-37.7</x><y>0</y><z>26.6</z></location>
        <orient unit="DEG"><roll>0</roll><pitch>0</pitch><yaw>0</yaw></orient>
        <sense>-1</sense>
        <p_factor>10.0</p_factor>
      </thruster>
    </engine>
  </propulsion>
  <flight_control name="BoxPlane FCS">
    <channel name="Controls">
      <aerosurface_scale name="Elevator">
        <input>fcs/elevator-cmd-norm</input>
        <range><min>-0.35</min><max>0.30</max></range>
        <output>fcs/elevator-pos-rad</output>
      </aerosurface_scale>
      <aerosurface_scale name="Aileron">
        <input>fcs/aileron-cmd-norm</input>
        <range><min>-0.35</min><max>0.35</max></range>
        <output>fcs/aileron-pos-rad</output>
      </aerosurface_scale>
      <aerosurface_scale name="Rudder">
        <input>fcs/rudder-cmd-norm</input>
        <range><min>-0.35</min><max>0.35</max></range>
        <output>fcs/rudder-pos-rad</output>
      </aerosurface_scale>
    </channel>
  </flight_control>
  <aerodynamics>
    <axis name="LIFT">
      <function name="aero/coefficient/CLwbh">
        <description>Lift due to alpha (c172x stall curve)</description>
        <product>
          <property>aero/qbar-area</property>
          <table>
            <independentVar lookup="row">aero/alpha-rad</independentVar>
            <tableData>
              -0.09 -0.22
               0.0   0.25
               0.09  0.73
               0.1   0.83
               0.12  0.92
               0.14  1.02
               0.16  1.08
               0.17  1.13
               0.19  1.19
               0.21  1.25
               0.24  1.35
               0.26  1.44
               0.28  1.47
               0.3   1.43
               0.32  1.38
               0.34  1.3
               0.36  1.15
            </tableData>
          </table>
        </product>
      </function>
      <function name="aero/coefficient/CLDe">
        <product><property>aero/qbar-area</property><property>fcs/elevator-pos-rad</property><value>0.347</value></product>
      </function>
      <function name="aero/coefficient/CLq">
        <product><property>aero/qbar-area</property><property>velocities/q-aero-rad_sec</property><property>aero/ci2vel</property><value>3.9</value></product>
      </function>
    </axis>
    <axis name="DRAG">
      <function name="aero/coefficient/CDwbh">
        <product>
          <property>aero/qbar-area</property>
          <table>
            <independentVar lookup="row">aero/alpha-rad</independentVar>
            <tableData>
              -0.09 0.035
               0.0  0.031
               0.09 0.045
               0.16 0.075
               0.24 0.14
               0.28 0.19
               0.36 0.35
            </tableData>
          </table>
        </product>
      </function>
      <function name="aero/coefficient/CDbeta">
        <product><property>aero/qbar-area</property><abs><property>aero/beta-rad</property></abs><value>0.17</value></product>
      </function>
    </axis>
    <axis name="SIDE">
      <function name="aero/coefficient/CYb">
        <product><property>aero/qbar-area</property><property>aero/beta-rad</property><value>-0.31</value></product>
      </function>
      <function name="aero/coefficient/CYr">
        <product><property>aero/qbar-area</property><property>velocities/r-aero-rad_sec</property><property>aero/bi2vel</property><value>0.21</value></product>
      </function>
      <function name="aero/coefficient/CYdr">
        <product><property>aero/qbar-area</property><property>fcs/rudder-pos-rad</property><value>0.187</value></product>
      </function>
    </axis>
    <axis name="ROLL">
      <function name="aero/coefficient/Clb">
        <product><property>aero/qbar-area</property><property>metrics/bw-ft</property><property>aero/beta-rad</property><value>-0.089</value></product>
      </function>
      <function name="aero/coefficient/Clp">
        <product><property>aero/qbar-area</property><property>metrics/bw-ft</property><property>velocities/p-aero-rad_sec</property><property>aero/bi2vel</property><value>-0.47</value></product>
      </function>
      <function name="aero/coefficient/Clr">
        <product><property>aero/qbar-area</property><property>metrics/bw-ft</property><property>velocities/r-aero-rad_sec</property><property>aero/bi2vel</property><value>0.096</value></product>
      </function>
      <function name="aero/coefficient/Clda">
        <product><property>aero/qbar-area</property><property>metrics/bw-ft</property><property>fcs/aileron-pos-rad</property><value>0.178</value></product>
      </function>
      <function name="aero/coefficient/Cldr">
        <product><property>aero/qbar-area</property><property>metrics/bw-ft</property><property>fcs/rudder-pos-rad</property><value>0.0147</value></product>
      </function>
    </axis>
    <axis name="PITCH">
      <function name="aero/coefficient/Cm0">
        <product><property>aero/qbar-area</property><property>metrics/cbarw-ft</property><value>0.04</value></product>
      </function>
      <function name="aero/coefficient/Cmalpha">
        <product><property>aero/qbar-area</property><property>metrics/cbarw-ft</property><property>aero/alpha-rad</property><value>-0.89</value></product>
      </function>
      <function name="aero/coefficient/Cmq">
        <product><property>aero/qbar-area</property><property>metrics/cbarw-ft</property><property>velocities/q-aero-rad_sec</property><property>aero/ci2vel</property><value>-12.4</value></product>
      </function>
      <function name="aero/coefficient/Cmde">
        <product><property>aero/qbar-area</property><property>metrics/cbarw-ft</property><property>fcs/elevator-pos-rad</property><value>-1.28</value></product>
      </function>
    </axis>
    <axis name="YAW">
      <function name="aero/coefficient/Cnb">
        <product><property>aero/qbar-area</property><property>metrics/bw-ft</property><property>aero/beta-rad</property><value>0.065</value></product>
      </function>
      <function name="aero/coefficient/Cnp">
        <product><property>aero/qbar-area</property><property>metrics/bw-ft</property><property>velocities/p-aero-rad_sec</property><property>aero/bi2vel</property><value>-0.03</value></product>
      </function>
      <function name="aero/coefficient/Cnr">
        <product><property>aero/qbar-area</property><property>metrics/bw-ft</property><property>velocities/r-aero-rad_sec</property><property>aero/bi2vel</property><value>-0.099</value></product>
      </function>
      <function name="aero/coefficient/Cndr">
        <product><property>aero/qbar-area</property><property>metrics/bw-ft</property><property>fcs/rudder-pos-rad</property><value>-0.0657</value></product>
      </function>
      <function name="aero/coefficient/Cnda">
        <product><property>aero/qbar-area</property><property>metrics/bw-ft</property><property>fcs/aileron-pos-rad</property><value>-0.053</value></product>
      </function>
    </axis>
  </aerodynamics>
</fdm_config>
