  <propulsion></propulsion>
  <flight_control name="DeLorean">
    <property value="0"> fcs/hover-cmd-norm </property>
    <property value="0"> fcs/vert-cmd-norm </property>
    <property value="0"> fcs/throttle-cmd-norm </property>
    <channel name="Drive">
