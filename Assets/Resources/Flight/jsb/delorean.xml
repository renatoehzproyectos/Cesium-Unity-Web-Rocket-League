      <spring_coeff unit="LBS/FT"> 9500 </spring_coeff><damping_coeff unit="LBS/FT/SEC"> 950 </damping_coeff><damping_coeff_rebound unit="LBS/FT/SEC"> 1500 </damping_coeff_rebound>
